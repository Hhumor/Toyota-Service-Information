<!DOCTYPE html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>丰田维修服务信息系统</title>
    <link rel="stylesheet" href="/system/css/global.css" />
    <link rel="stylesheet" href="/system/css/facebox.css" />
    <link rel="stylesheet" href="/css/contents.css" />
    <link rel="stylesheet" href="/css/print.css" />
    <link rel="stylesheet" href="/css/index.css" />
    <style>
      #content-frame #header,
      #content-frame #footer {
        display: none;
      }
    </style>
  </head>
  <body>
    <div id="container">
      <div id="header">
        <h1>丰田维修服务信息系统</h1>
        <button id="sidebar-toggle" class="sidebar-toggle" type="button">目录</button>
      </div>
      <div id="main">
        <div id="sidebar">
          <div id="sidebar-header">
            <h2>目录导航</h2>
          </div>
          <div id="search-container">
            <input type="text" id="search-input" placeholder="搜索目录..." autocomplete="off" />
            <button type="button" id="search-clear" class="search-clear hidden">&times;</button>
            <div id="search-results" class="search-results hidden"></div>
          </div>
          <div id="tree-container">
            <div id="loading">加载目录中...</div>
          </div>
        </div>
        <div id="content">
          <div id="content-welcome">
            <div class="welcome-icon"></div>
            <div class="welcome-text">欢迎使用丰田维修服务信息系统</div>
            <div class="welcome-subtext">请从目录中选择一个项目以查看内容</div>
          </div>
          <div id="content-placeholder" class="content-placeholder hidden">
            <div class="placeholder-icon"></div>
            <div class="placeholder-text">加载中...</div>
            <div class="placeholder-subtext">请稍候</div>
          </div>
          <div id="content-frame" class="hidden" style="overflow: auto;">
            <div id="wrapper">
              <div id="body">
                <div id="contents">
                  <div id="contentsBody" class="fontEn"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script is:inline src="/system/js/contents.js"></script>
    <script is:inline src="/system/js/toc-loader.js"></script>
    <noscript>请启用浏览器脚本以浏览内容。</noscript>
  </body>
</html>
